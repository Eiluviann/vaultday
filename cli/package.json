{
	"name": "@vaultday/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The vaultday command line over the Rust core: today, and in PR 6 log, report, task and the MCP server.",
	"bin": {
		"vaultday": "./dist/main.js"
	},
	"engines": {
		"node": ">=22.15"
	},
	"scripts": {
		"start": "tsx src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@vaultday/core-node": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
