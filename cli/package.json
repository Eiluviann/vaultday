{
	"name": "@vaultday/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The vaultday command line and stdio MCP server over the Rust core: today, log, report, task add and task done.",
	"bin": {
		"vaultday": "./dist/main.js"
	},
	"engines": {
		"node": ">=22.15"
	},
	"scripts": {
		"start": "tsx src/main.ts",
		"build": "tsx scripts/bundle.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@vaultday/core-node": "workspace:*"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"@types/node": "^22.20.5",
		"@vaultday/provenance-core": "workspace:*",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4",
		"zod": "4.6.7"
	},
	"files": [
		"dist"
	]
}
