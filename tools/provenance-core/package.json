{
	"name": "@vaultday/provenance-core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Vendored copy of the AI-provenance engine behind the Claude Code vault hook, with a parity check against the live copy.",
	"engines": {
		"node": ">=22.15"
	},
	"exports": {
		".": "./vendor/obsidian-ai-provenance-core.mjs"
	},
	"scripts": {
		"test": "node --test vendor/*.test.mjs && tsx src/parity.ts",
		"parity": "tsx src/parity.ts",
		"sync": "tsx src/parity.ts --sync",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
