{
	"name": "@vaultday/tokens",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Generates the SwiftUI design tokens (apps/apple/Vaultday/Tokens.swift) from design/tokens.json.",
	"engines": {
		"node": ">=22.15"
	},
	"scripts": {
		"generate": "tsx src/main.ts",
		"check": "tsx src/main.ts --check",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"zod": "^4.6.7"
	}
}
