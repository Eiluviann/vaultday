// Signing for the Mac app (docs/signing.md). Without a local file this
// signs ad hoc ("Sign to Run Locally") with the entitlements macOS honours
// without a provisioning profile: keys in the login keychain, app state in
// ~/Library/Application Support/Vaultday, nothing synchronised.
//
// For a free Personal Team, write into Signing.local.xcconfig (gitignored):
//   DEVELOPMENT_TEAM = <your team id>
//   #include "Signing.personal-team.xcconfig"
// For a paid team: DEVELOPMENT_TEAM, CODE_SIGN_IDENTITY = Apple Development
// and VAULTDAY_ENTITLEMENTS = Signing/Full.entitlements.

// The identifiers the shipped app claims. A Personal Team replaces them with
// its own (Signing.personal-team.xcconfig).
VAULTDAY_BUNDLE_IDENTIFIER = com.eiluviann.vaultday
VAULTDAY_APP_GROUP = group.com.eiluviann.vaultday
VAULTDAY_KEYCHAIN_ACCESS_GROUP = group.com.eiluviann.vaultday

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
VAULTDAY_ENTITLEMENTS = Signing/AdHoc.entitlements
#include? "Signing.local.xcconfig"
